#!/bin/bash
# Author: Satish Gaikwad <satish@satishweb.com>
set -e

DOH_CONFIG_SAMPLE_FILE=/server/doh-server.sample.conf
# The configuration file that the server reads. It can be changed with the
# DOH_CONFIG_FILE environment variable.
DOH_CONFIG_FILE=${DOH_CONFIG_FILE:-/server/doh-server.conf}
SECRET_FILE_ENV_SUFFIX=_FILE
# Variables that end in _FILE but hold a path, not a pointer to a secret.
NOT_SECRET_FILE_VARS=(
    DOH_CONFIG_FILE
)
SECRET_DIR=/run/secrets

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------
__log()   { printf "| ENTRYPOINT: %s\n" "$*"; }
__warn()  { printf "| ENTRYPOINT: \033[0;33m%s\033[0m\n" "$*" >&2; }
__error() { printf "| ENTRYPOINT: \033[0;31m%s\033[0m\n" "$*" >&2; }

# ---------------------------------------------------------------------------
# Docker secrets
#
# Docker (compose) and Swarm expose secrets as files below /run/secrets and
# point at them through a "<NAME>_FILE" environment variable.  Every secret
# that is referenced this way is exported as a plain environment variable so
# that it can be referenced from the configuration template.
#
# Only the *names* of the variables are iterated over and the file contents
# are read verbatim.  This keeps secret values containing whitespace or shell
# metacharacters intact.
# ---------------------------------------------------------------------------
__secretNames() {
    local name excluded
    env | sed -n "s/^\([A-Za-z_][A-Za-z0-9_]*\)${SECRET_FILE_ENV_SUFFIX}=.*/\1/p" | sort -u |
    while read -r name; do
        for excluded in "${NOT_SECRET_FILE_VARS[@]}"; do
            [ "${name}${SECRET_FILE_ENV_SUFFIX}" = "${excluded}" ] && continue 2
        done
        echo "${name}"
    done
}

__loadSecrets() {
    local names varName varFile value
    names="$(__secretNames)"

    for varName in ${names}; do
        varFile="$(printenv "${varName}${SECRET_FILE_ENV_SUFFIX}")"
        if [ ! -f "${varFile}" ]; then
            __warn "Secret file '${varFile}' for '${varName}' is missing, skipping."
            continue
        fi
        value="$(cat "${varFile}")"
        export "${varName}=${value}"
        __log "Exporting var: ${varName}"
    done

    # Keep a copy of the resolved secrets around for troubleshooting.  The
    # container runs as an unprivileged user, so this must not be written to
    # /etc/profile (which is owned by root) - doing so aborts the container.
    local envFile=/tmp/doh-secrets.env
    : > "${envFile}" 2>/dev/null || return 0
    for varName in ${names}; do
        printf 'export %s=%q\n' "${varName}" "$(printenv "${varName}")" >> "${envFile}" 2>/dev/null || true
    done
    __log "Resolved secrets written to ${envFile}"
}

# ---------------------------------------------------------------------------
# Value normalisation
#
# The upstream doh-server rejects the configuration file with rather cryptic
# messages when a value is empty or malformed.  Normalising the values here
# keeps the failure modes obvious and the container startable.
# ---------------------------------------------------------------------------
__isTrue() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

__toBool() {
    if __isTrue "$1"; then echo "true"; else echo "false"; fi
}

__toUint() {
    local value="$1" name="$2" fallback="$3"
    if [ -z "${value}" ]; then
        __warn "${name} is empty, using default '${fallback}'."
        echo "${fallback}"
        return 0
    fi
    if ! printf '%s' "${value}" | grep -Eq '^[0-9]+$'; then
        __error "${name} must be a non negative integer, got '${value}'."
        exit 1
    fi
    echo "${value}"
}

__applyDefaults() {
    # Upstream falls back to 127.0.0.1 only when the option is missing, an
    # empty value is rejected.  Keep the image defaults in sync with the
    # Dockerfile ENV declarations.
    if [ -z "${UPSTREAM_DNS_SERVER}" ]; then
        __warn "UPSTREAM_DNS_SERVER is empty, using the image default."
        export UPSTREAM_DNS_SERVER="udp:208.67.222.222:53,udp:208.67.220.220:53"
    fi
    if [ -z "${DOH_HTTP_PREFIX}" ]; then
        __warn "DOH_HTTP_PREFIX is empty, using the image default."
        export DOH_HTTP_PREFIX="/getnsrecord"
    fi
    if [ -z "${DOH_HTTP_PREFIXES}" ]; then
        __warn "DOH_HTTP_PREFIXES is empty, using the image default."
        export DOH_HTTP_PREFIXES="/dns-query"
    fi
    if [ -z "${DOH_SERVER_LISTEN}" ]; then
        __warn "DOH_SERVER_LISTEN is empty, using the image default."
        export DOH_SERVER_LISTEN=":8053"
    fi

    export DOH_SERVER_TIMEOUT
    DOH_SERVER_TIMEOUT="$(__toUint "${DOH_SERVER_TIMEOUT}" "DOH_SERVER_TIMEOUT" "10")"
    export DOH_SERVER_TRIES
    DOH_SERVER_TRIES="$(__toUint "${DOH_SERVER_TRIES}" "DOH_SERVER_TRIES" "3")"
    export DOH_SERVER_VERBOSE
    DOH_SERVER_VERBOSE="$(__toBool "${DOH_SERVER_VERBOSE}")"
    export DOH_SERVER_LOG_GUESSED_CLIENT_IP
    DOH_SERVER_LOG_GUESSED_CLIENT_IP="$(__toBool "${DOH_SERVER_LOG_GUESSED_CLIENT_IP}")"
    export DOH_SERVER_ECS_ALLOW_NON_GLOBAL_IP
    DOH_SERVER_ECS_ALLOW_NON_GLOBAL_IP="$(__toBool "${DOH_SERVER_ECS_ALLOW_NON_GLOBAL_IP}")"
    export DOH_SERVER_ECS_USE_PRECISE_IP
    DOH_SERVER_ECS_USE_PRECISE_IP="$(__toBool "${DOH_SERVER_ECS_USE_PRECISE_IP}")"
    export DOH_SERVER_TLS_CLIENT_AUTH
    DOH_SERVER_TLS_CLIENT_AUTH="$(__toBool "${DOH_SERVER_TLS_CLIENT_AUTH}")"

    # The upstream server refuses to start when only one of the certificate
    # and the key is set, so the check is done here to give a clear message.
    if [ -n "${DOH_SERVER_CERT}" ] && [ -z "${DOH_SERVER_KEY}" ]; then
        __error "DOH_SERVER_KEY is missing. The certificate and the key have to be set together."
        exit 1
    fi
    if [ -z "${DOH_SERVER_CERT}" ] && [ -n "${DOH_SERVER_KEY}" ]; then
        __error "DOH_SERVER_CERT is missing. The certificate and the key have to be set together."
        exit 1
    fi
    if [ "${DOH_SERVER_TLS_CLIENT_AUTH}" = "true" ] && [ -z "${DOH_SERVER_TLS_CLIENT_AUTH_CA}" ]; then
        __error "DOH_SERVER_TLS_CLIENT_AUTH_CA is missing. It is required when the client authentication is enabled."
        exit 1
    fi
}

# Build the list of HTTP paths the resolve endpoint is served on.
# The upstream server registers every entry of the comma separated "path"
# option on its HTTP mux, so the endpoint can be reachable under more than
# one URL at the same time.
__buildHttpPaths() {
    local -a paths=()
    local -a parts=()
    local part trimmed out existing duplicate

    IFS=',' read -r -a parts <<< "${DOH_HTTP_PREFIX},${DOH_HTTP_PREFIXES}"

    for part in "${parts[@]}"; do
        trimmed="$(printf '%s' "${part}" | tr -d '[:space:]')"
        [ -z "${trimmed}" ] && continue
        # A path has to start with a slash, otherwise the upstream server
        # refuses to start.
        case "${trimmed}" in
            /*) ;;
            *)
                __error "Invalid HTTP path '${trimmed}'. A path must start with a slash, e.g. /dns-query"
                exit 1
                ;;
        esac
        # The same path must not be registered twice, the upstream server
        # panics when it happens. That happens for example when the primary
        # path is the same as one of the additional paths.
        duplicate=0
        for existing in "${paths[@]}"; do
            if [ "${existing}" = "${trimmed}" ]; then
                duplicate=1
                break
            fi
        done
        if [ ${duplicate} -eq 1 ]; then
            __log "HTTP path '${trimmed}' is already configured, skipping it."
            continue
        fi
        paths+=("${trimmed}")
    done

    if [ ${#paths[@]} -eq 0 ]; then
        __error "No HTTP path configured."
        exit 1
    fi

    out="${paths[0]}"
    for trimmed in "${paths[@]:1}"; do
        out="${out},${trimmed}"
    done

    export doh_http_paths="${out}"
}

# Build the TOML "upstream" array out of the (optionally comma separated)
# UPSTREAM_DNS_SERVER value.  Upstream picks one server at random per attempt,
# so listing more than one gives a simple form of redundancy.
__buildUpstreamArray() {
    local raw="${UPSTREAM_DNS_SERVER}"
    local -a parts=()
    local -a servers=()
    local part trimmed out

    IFS=',' read -r -a parts <<< "${raw}"

    for part in "${parts[@]}"; do
        trimmed="$(printf '%s' "${part}" | tr -d '[:space:]')"
        [ -z "${trimmed}" ] && continue
        servers+=("${trimmed}")
    done

    if [ ${#servers[@]} -eq 0 ]; then
        __error "No upstream DNS server configured."
        exit 1
    fi

    # Upstream only understands the udp, tcp and tcp-tls prefixes.  Checking
    # them here produces a much clearer error message than the upstream one.
    for trimmed in "${servers[@]}"; do
        case "${trimmed}" in
            udp:*|tcp:*|tcp-tls:*) ;;
            *)
                __error "Invalid upstream '${trimmed}'. Expected a udp|tcp|tcp-tls prefix, e.g. udp:1.1.1.1:53"
                exit 1
                ;;
        esac
    done

    out=""
    for trimmed in "${servers[@]}"; do
        if [ -z "${out}" ]; then
            out="\"${trimmed}\""
        else
            out="${out},\"${trimmed}\""
        fi
    done

    export upstream_servers="[${out}]"
}

# ---------------------------------------------------------------------------
# Configuration file
#
# The configuration is generated from the bundled template unless the user
# supplied one.  An existing file is never overwritten.
#
# The path of the file is set with the DOH_CONFIG_FILE environment variable,
# that way a custom configuration can be kept in a directory of its own
# without it being replaced by the generated one.
# ---------------------------------------------------------------------------
__generateConfig() {
    if [ -f "${DOH_CONFIG_FILE}" ]; then
        __log "Using the existing configuration file: ${DOH_CONFIG_FILE}"
        return 0
    fi

    if [ ! -f "${DOH_CONFIG_SAMPLE_FILE}" ]; then
        __error "Configuration template not found: ${DOH_CONFIG_SAMPLE_FILE}"
        exit 1
    fi

    local configDir
    configDir="$(dirname "${DOH_CONFIG_FILE}")"
    if [ ! -d "${configDir}" ]; then
        __log "Creating the directory ${configDir} for the configuration file."
        mkdir -p "${configDir}" || {
            __error "Could not create the directory ${configDir}."
            exit 1
        }
    fi

    local tmpFile
    tmpFile="$(mktemp "${TMPDIR:-/tmp}/doh-server.conf.XXXXXX")"
    # Only our own template is expanded, so a user supplied configuration can
    # never be corrupted by the shell substitution.
    envsubst < "${DOH_CONFIG_SAMPLE_FILE}" > "${tmpFile}"
    chmod 0644 "${tmpFile}"
    mv "${tmpFile}" "${DOH_CONFIG_FILE}"
    __log "Generated configuration file: ${DOH_CONFIG_FILE}"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
printf "|---------------------------------------------------------------------------------------------\n"
printf "| Starting DNS Over HTTP Service \n"

__log "Loading docker secrets if found..."
__loadSecrets

# DEBUG may be provided as a plain variable or through a secret.  A secret
# named "DEBUG" is also honoured for backwards compatibility.
if [ -z "${DEBUG}" ] && [ -f "${SECRET_DIR}/DEBUG" ]; then
    DEBUG="$(cat "${SECRET_DIR}/DEBUG")"
    export DEBUG
    __log "Exporting var: DEBUG"
fi

if __isTrue "${DEBUG}"; then
    set -x
fi

__applyDefaults
__buildHttpPaths
__buildUpstreamArray
__generateConfig

# The server is started with the configuration file of the image.  When the
# path of the configuration is changed, the argument of the server is
# adjusted.  An argument that was given on the command line always wins.
# The positional parameters have to be changed here and not in a function,
# they are local to a function.
if [ $# -ge 3 ] && [ "$1" = "/server/doh-server" ] && [ "$2" = "-conf" ] && [ "$3" = "/server/doh-server.conf" ]; then
    set -- "$1" "$2" "${DOH_CONFIG_FILE}"
fi

# Check if app-config is present
if [ -f /app-config ]; then
    # We expect that app-config handles the launch of app command
    __log "Executing app-config..."
    # shellcheck disable=SC1091
    . /app-config "$@"
else
    # Let default CMD run if app-config is missing
    if [ $# -eq 0 ]; then
        __error "No command given, nothing to start."
        exit 1
    fi
    __log "app-config was not available, running given parameters or default CMD..."
    exec "$@"
fi
